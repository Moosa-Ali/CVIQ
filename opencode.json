{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "cviq-engineering-manager",
  "model": "openrouter/deepseek/deepseek-v4-pro",
  "small_model": "openrouter/google/gemma-4-31b-it",
  "subagent_depth": 2,
  "instructions": [
    "AGENTS.md",
    "sdlc/PROJECT_CONTEXT.md"
  ],
  "permission": {
    "external_directory": "deny"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "timeout": 30000
    }
  }
}
